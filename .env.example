# Copy to .env (never commit .env — the repo is public).
# Supabase project settings -> API. The anon key is safe in the app; RLS protects data.
EXPO_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=YOUR-ANON-KEY

# Mapbox public token (starts with pk.)
EXPO_PUBLIC_MAPBOX_TOKEN=pk.YOUR-PUBLIC-TOKEN

# Mapbox secret download token (starts with sk., scope DOWNLOADS:READ). Build-time only:
# set it as an EAS secret, not in the app.
RNMAPBOX_MAPS_DOWNLOAD_TOKEN=sk.YOUR-DOWNLOAD-TOKEN

# Where the map opens before location permission (dev sample area: London, Shoreditch).
EXPO_PUBLIC_DEFAULT_LAT=51.5246
EXPO_PUBLIC_DEFAULT_LNG=-0.0781
